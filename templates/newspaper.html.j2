<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{{ masthead }}</title>
<style>
{{ css }}
</style>
</head>
<body>

<header class="masthead">
    <div class="masthead-top">
        <span class="edition-tag">ÉDITION QUOTIDIENNE</span>
        <span class="edition-tag">{{ date_str }}</span>
    </div>
    <h1 class="masthead-title">{{ masthead }}</h1>
    <div class="masthead-sub">
        <span>Météo &middot; Actualités &middot; Jeux &middot; Emploi</span>
    </div>
    <div class="rule-thick"></div>
</header>

<!-- ===================== MÉTÉO (bandeau du haut) ===================== -->
{% if weather %}
<section class="weather-strip">
    <h2 class="section-label">Bulletin météo national</h2>
    <div class="weather-grid">
        {% for w in weather %}
        <div class="weather-card">
            <div class="weather-city">{{ w.region }}</div>
            <div class="weather-temp">{{ w.t_min }}° / {{ w.t_max }}°</div>
            <div class="weather-condition">{{ w.sky_label }}</div>
            <div class="weather-detail">Vent {{ w.wind_kmh }} km/h &middot; Pluie {{ w.rain_mm }} mm</div>
        </div>
        {% endfor %}
    </div>
    {% if weather[0] %}
    <p class="weather-narrative">
        Moyenne nationale {{ weather[0].national_avg_min }}° / {{ weather[0].national_avg_max }}°.
        Le plus chaud : {{ weather[0].hottest_city }} ({{ weather[0].hottest_temp }}°).
        Le plus frais : {{ weather[0].coldest_city }} ({{ weather[0].coldest_temp }}°).
    </p>
    {% endif %}
</section>
<div class="rule-thin"></div>
{% endif %}

<!-- ===================== ARTICLES (corps en colonnes) ===================== -->
{% if rss_articles %}
<section class="articles">
    <h2 class="section-label">À la une</h2>
    <div class="article-columns">
        {% for a in rss_articles %}
        <article class="article {% if loop.first %}article-lead{% endif %}">
            <h3 class="article-title">{{ a.title }}</h3>
            <p class="article-summary">{{ a.body | truncate_words(70) }}</p>
            <div class="article-meta">{{ a.url | domain_only }}</div>
        </article>
        {% endfor %}
    </div>
</section>
<div class="rule-thin"></div>
{% endif %}

<!-- ===================== JEUX STEAM ===================== -->
{% if steam_games.trending or steam_games.upcoming or steam_games.demos %}
<section class="steam">
    <h2 class="section-label">Le coin du jeu vidéo</h2>
    <div class="steam-columns">
        {% if steam_games.trending %}
        <div class="steam-block">
            <h3 class="steam-subtitle">En vogue sur Steam</h3>
            {% for g in steam_games.trending %}
            <div class="game-entry">
                <div class="game-entry-header">
                    <span class="game-name">{{ g.name }}{% if g.on_sale %} <span class="badge-sale">PROMO</span>{% endif %}</span>
                    {% if g.price %}<span class="game-price">{{ g.price }}</span>{% endif %}
                </div>
                <div class="game-desc">{{ g.description | truncate_words(45) }}</div>
                {% if g.tags %}<div class="game-tags">{{ g.tags | first_tags(4) }}</div>{% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
        {% if steam_games.upcoming %}
        <div class="steam-block">
            <h3 class="steam-subtitle">À paraître</h3>
            {% for g in steam_games.upcoming %}
            <div class="game-entry">
                <div class="game-entry-header">
                    <span class="game-name">{{ g.name }}</span>
                    {% if g.price %}<span class="game-price">{{ g.price }}</span>{% endif %}
                </div>
                <div class="game-desc">{{ g.description | truncate_words(45) }}</div>
                {% if g.release and g.release != "Upcoming" %}
                <div class="game-meta">Sortie prévue : {{ g.release }}</div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
        {% if steam_games.demos %}
        <div class="steam-block">
            <h3 class="steam-subtitle">Démos à essayer</h3>
            {% for g in steam_games.demos %}
            <div class="game-entry game-entry-compact">
                <span class="game-name">{{ g.name }}</span>
                <div class="game-desc">{{ g.description | truncate_words(28) }}</div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>
<div class="rule-thin"></div>
{% endif %}

<!-- ===================== OFFRES D'EMPLOI ===================== -->
{% if linkedin_jobs %}
<section class="jobs">
    <h2 class="section-label">Petites annonces &mdash; Offres d'emploi</h2>
    <table class="jobs-table">
        <thead>
            <tr>
                <th>Poste</th>
                <th>Entreprise</th>
                <th>Lieu</th>
                <th>Télétravail</th>
                <th>Compétences</th>
            </tr>
        </thead>
        <tbody>
            {% for j in linkedin_jobs %}
            <tr>
                <td class="job-title">{{ j.title }}</td>
                <td>{{ j.company }}</td>
                <td>{{ j.location }}</td>
                <td>{{ j.work_type if j.work_type else "—" }}</td>
                <td class="job-skills">{{ j.skills_found }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endif %}

<footer class="newspaper-footer">
    <div class="rule-thin"></div>
    <span>Généré automatiquement le {{ generated_at }} &middot; virtual-newspaper</span>
</footer>

</body>
</html>
